{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/plugin/v2.4/schema.json",
  "schema_version": "v2.4",
  "name_for_human": "inSitu Sales",
  "description_for_human": "Find customer, sales, product and inventory information from your connected inSitu Sales account.",
  "contact_email": "support@insitusales.com",
  "namespace": "insitusales",
  "functions": [],
  "runtimes": [
    {
      "type": "RemoteMCPServer",
      "spec": {
        "url": "https://api.insitusales.com/mcp"
      },
      "run_for_functions": [
        "*"
      ],
      "auth": {
        "type": "OAuthPluginVault",
        "reference_id": "${{INSITUSALES_MCP_AUTH_ID}}"
      }
    }
  ]
}
